{
  "name": "@skastr0/quartz-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js",
      "default": "./dist/discovery.js"
    },
    "./project-types": {
      "types": "./dist/project-types.d.ts",
      "import": "./dist/project-types.js",
      "default": "./dist/project-types.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/discovery.ts ./src/project-types.ts --outdir ./dist --target node --format esm --external effect --external ts-morph && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "effect": "^3.21.2",
    "ts-morph": "^28.0.0"
  },
  "license": "MIT",
  "description": "Effect-native TypeScript code intelligence core for quartz.",
  "keywords": [
    "quartz",
    "typescript",
    "type-analysis",
    "code-intelligence",
    "static-analysis",
    "transform-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/quartz.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/skastr0/quartz#readme",
  "bugs": {
    "url": "https://github.com/skastr0/quartz/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
