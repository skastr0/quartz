#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

locate_orb_setup() {
  local candidate
  for candidate in \
    "${repo_root}/../repos/orb-setup" \
    "${repo_root}/../repos/skastr0/orb-setup" \
    "${repo_root}/../orb-setup"; do
    if [[ -x "${candidate}/bin/setup.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

install_pinned_bun() {
  local bun_version
  bun_version="$(sed -n 's/.*"packageManager": *"bun@\([^"]*\)".*/\1/p' package.json)"
  if [[ -z "$bun_version" ]]; then
    printf '[setup] error: package.json must declare packageManager as bun@<version>\n' >&2
    exit 1
  fi
  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  local bun_bin="$BUN_INSTALL/bin/bun"
  local started=$SECONDS
  if [[ ! -x "$bun_bin" ]] || [[ "$("$bun_bin" --version)" != "$bun_version" ]]; then
    printf '[setup] Installing Bun %s\n' "$bun_version"
    curl -fsSL https://bun.sh/install | bash -s -- "bun-v${bun_version}"
  else
    printf '[setup] Bun %s is already installed\n' "$bun_version"
  fi
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$bun_bin" "$HOME/.local/bin/bun"
  export PATH="${BUN_INSTALL}/bin:${HOME}/.local/bin:${PATH}"
  if [[ "$(bun --version)" != "$bun_version" ]]; then
    printf '[setup] error: expected Bun %s, found %s\n' "$bun_version" "$(bun --version)" >&2
    exit 1
  fi
  printf '[setup] Using Bun %s (%ss)\n' "$(bun --version)" "$((SECONDS - started))"
}

# Rig's quartz check is `test -x ~/.local/bin/quartz`. That check follows
# symlinks, and the source entry is mode 644, so a symlink reads as missing
# and Rig runs the published install. An executable file already at that
# path makes the published install a skip. Write it before Rig, and write
# it again after, so a published bin from an empty prefix cannot remain.
link_workspace_cli() {
  local entry="$repo_root/apps/cli/src/main.ts"
  local link="$HOME/.local/bin/quartz"
  if [[ ! -f "$entry" ]]; then
    printf '[setup] error: workspace quartz entrypoint missing at %s\n' "$entry" >&2
    exit 1
  fi
  mkdir -p "$HOME/.local/bin"
  cat > "$link" <<EOF
#!/usr/bin/env bash
exec bun "$entry" "\$@"
EOF
  chmod 755 "$link"
  if [[ ! -x "$link" ]] || [[ -L "$link" ]] || ! grep -Fq "$entry" "$link" || ! grep -Fq 'exec bun' "$link"; then
    printf '[setup] error: workspace quartz command was not preserved\n' >&2
    exit 1
  fi
}

persist_tool_paths() {
  local marker="# quartz toolchain PATH"
  local profile="$HOME/.bash_profile"
  touch "$profile"
  if grep -Fqx "$marker" "$profile" 2>/dev/null; then
    return
  fi
  cat >> "$profile" <<EOF

$marker
export BUN_INSTALL="\$HOME/.bun"
if [ -d "\$BUN_INSTALL/bin" ]; then
  case ":\$PATH:" in
    *":\$BUN_INSTALL/bin:"*) ;;
    *) export PATH="\$BUN_INSTALL/bin:\$PATH" ;;
  esac
fi
if [ -d "\$HOME/.local/bin" ]; then
  case ":\$PATH:" in
    *":\$HOME/.local/bin:"*) ;;
    *) export PATH="\$HOME/.local/bin:\$PATH" ;;
  esac
fi
EOF
}

orb_setup="$(locate_orb_setup)" || {
  printf '[setup] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
printf '[setup] Using shared runtime at %s\n' "$orb_setup"
link_workspace_cli
bash "${orb_setup}/bin/setup.sh"
export PATH="${HOME}/.bun/bin:${HOME}/.local/bin:${PATH}"

install_pinned_bun
persist_tool_paths
link_workspace_cli

started=$SECONDS
printf '[setup] Installing workspace dependencies\n'
bun install --frozen-lockfile
printf '[setup] Workspace dependencies ready (%ss)\n' "$((SECONDS - started))"
printf '[setup] Building workspace quartz CLI\n'
bun run cli:build
link_workspace_cli
printf '[setup] Complete; quartz workspace -> %s\n' "$repo_root/apps/cli/src/main.ts"
