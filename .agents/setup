#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

bun_version="$(sed -n 's/.*"packageManager": *"bun@\([^"]*\)".*/\1/p' package.json)"
if [[ -z "$bun_version" ]]; then
  echo "Unable to determine the pinned Bun version from package.json" >&2
  exit 1
fi

export BUN_INSTALL="$HOME/.bun"
bun_bin="$BUN_INSTALL/bin/bun"
toolchain_started=$SECONDS
if [[ ! -x "$bun_bin" ]] || [[ "$($bun_bin --version)" != "$bun_version" ]]; then
  echo "Installing Bun $bun_version"
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v$bun_version"
else
  echo "Bun $bun_version is already installed"
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "$bun_bin" "$HOME/.local/bin/bun"
export PATH="$HOME/.local/bin:$PATH"
echo "Bun toolchain ready in $((SECONDS - toolchain_started))s"

dependencies_started=$SECONDS
echo "Installing workspace dependencies"
bun install --frozen-lockfile
echo "Workspace dependencies ready in $((SECONDS - dependencies_started))s"

# Install only: authentication belongs in resume, never in a shared snapshot.
sudo install -d /etc/systemd/system/tailscaled.service.d
sudo tee /etc/systemd/system/tailscaled.service.d/amp-orb.conf >/dev/null <<'EOF'
[Service]
Environment=TS_ASSUME_NETWORK_UP_FOR_TEST=true
EOF
if ! command -v tailscale >/dev/null; then
  curl -fsSL https://tailscale.com/install.sh | sh
fi
sudo systemctl daemon-reload

# Use the published CLI, independently of Quartz's workspace dependencies.
quasar_version="0.5.3"
quasar_package="$HOME/.local/lib/node_modules/@skastr0/quasar-cli/package.json"
if [[ ! -x "$HOME/.local/bin/quasar" ]] ||
   [[ "$(node -p 'require(process.argv[1]).version' "$quasar_package" 2>/dev/null || true)" != "$quasar_version" ]]; then
  npm install --global --prefix "$HOME/.local" "@skastr0/quasar-cli@$quasar_version"
fi
