{
  "name": "@skastr0/quartz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run apps/cli/src/main.ts",
    "build:cli": "bun scripts/build-cli.ts",
    "install:local": "bun scripts/install.ts",
    "cli:build": "bun run --filter @skastr0/quartz-cli build",
    "cli:install-local": "bun run --filter @skastr0/quartz-cli install:local",
    "build": "bun run --filter './apps/*' build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run test && bun run build && bun run verify:package-boundaries",
    "verify:package-boundaries": "bun scripts/verify-package-boundaries.ts",
    "release:check": "bun run verify && bun audit && publish-scan ."
  },
  "dependencies": {
    "effect": "^3.21.2",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@opencode-ai/plugin": "^1.14.46",
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0"
  },
  "overrides": {
    "uuid": "13.0.2"
  },
  "license": "MIT",
  "description": "TypeScript code intelligence and transform search tooling.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/quartz.git"
  },
  "homepage": "https://github.com/skastr0/quartz#readme",
  "bugs": {
    "url": "https://github.com/skastr0/quartz/issues"
  }
}
