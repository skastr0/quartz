{
  "name": "type-level-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run apps/cli/src/main.ts",
    "build": "bun run --filter './apps/*' build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "effect": "^3.21.0",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@opencode-ai/plugin": "^1.4.0",
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0"
  }
}
