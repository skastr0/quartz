{
  "name": "@skastr0/quartz-cli",
  "version": "0.2.3",
  "type": "module",
  "private": true,
  "bin": {
    "quartz": "dist/main.js"
  },
  "files": [
    "dist/main.js",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --target bun --format esm --external @skastr0/quartz-engine",
    "install:local": "bun run build && bun link"
  },
  "dependencies": {
    "@skastr0/quartz-engine": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "license": "MIT",
  "description": "Agent-native CLI for quartz TypeScript code intelligence.",
  "keywords": [
    "quartz",
    "cli",
    "typescript",
    "code-intelligence",
    "agent-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/quartz.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/skastr0/quartz#readme",
  "bugs": {
    "url": "https://github.com/skastr0/quartz/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
